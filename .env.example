# Copy this to .env and fill in your keys
# Get Groq API key from https://console.groq.com/keys (free tier available)
GROQ_API_KEY=your_groq_api_key_here

# Optional: save history per Gmail — Firebase (free, no limit) or Supabase
# Firebase: console.firebase.google.com -> Project Settings -> Service Accounts -> Generate key
# Paste whole JSON as one line in FIREBASE_CREDENTIALS_JSON, and set PROJECT_ID
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project", "private_key":"..."}
# Or Supabase alternative:
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
APP_URL=http://localhost:8501
# For live Render, set APP_URL to https://studyrag-4xvz.onrender.com
# Or Supabase alternative:
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
APP_URL=http://localhost:8501
# For live Render, set APP_URL to https://studyrag-4xvz.onrender.com