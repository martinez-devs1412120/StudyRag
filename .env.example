# Copy this to .env and fill in your keys
# Get Groq API key from https://console.groq.com/keys (free tier available)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: save history per Gmail — Firebase (free, no limit) or Supabase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_JSON=your-firebase-credentials-json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
APP_URL=http://localhost:8501
# Verified Google logins allowed to manage documents (comma-separated)
ADMIN_EMAILS=your@gmail.com

# --- Infrastructure (Task 2: docker-compose.yml) ---
# Matches the default credentials in docker-compose.yml; change for production.
DATABASE_URL=postgresql+psycopg://studyrag:studyrag@localhost:5432/studyrag
REDIS_URL=redis://localhost:6379/0
# Already declared above: GROQ_API_KEY
